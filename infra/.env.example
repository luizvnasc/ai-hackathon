# Copied to infra/.env by `make setup` (which also generates the secrets).
# Do not commit .env.

# ---------- Host ports ----------
JIRA_PORT=8080
GITLAB_HTTP_PORT=8929
GITLAB_SSH_PORT=2224
PLANE_PORT=8090

# ---------- Jira ----------
JIRA_VERSION=10.3.23
JIRA_DB_PASSWORD=jira
JIRA_JVM_MAX=2048m

# ---------- GitLab ----------
GITLAB_VERSION=19.5.3-ce.0
# root user password (min 8 chars, must not be too weak)
GITLAB_ROOT_PASSWORD=__GENERATED__

# ---------- Plane ----------
APP_RELEASE=v1.4.3
SECRET_KEY=__GENERATED__
LIVE_SERVER_SECRET_KEY=__GENERATED__
POSTGRES_PASSWORD=plane
RABBITMQ_PASSWORD=plane
AWS_ACCESS_KEY_ID=access-key
AWS_SECRET_ACCESS_KEY=__GENERATED__
# Instance admin created by `make plane` / `make plane-admin` (like GitLab's root).
# The email is only a login name; it does not need to exist.
PLANE_ADMIN_EMAIL=root@plane.local
PLANE_ADMIN_PASSWORD=__GENERATED__
